#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        lang_switch: lang_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp LSHFT>
                , <&macro_release &kp LALT>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
/* Row 0 */  &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &kp LBKT         &kp RBKT
/* Row 1 */  &kp A            &kp S            &kp D            &kp F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT          &kp BSLH
/* Row 2 */  &kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp SLASH        &kp MINUS        &kp EQUAL
/* Row 3 */                   &kp BSPC         &lang_switch     &mt LSHIFT ENTER &mt LCTRL SPACE  &mo 1            &mo 1            &mt RCTRL SPACE  &mt RSHIFT ENTER &tog 2           &kp DEL
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
/* Row 0 */  &kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT        &kp CARET        &kp AMPS         &kp STAR         &kp LPAR         &kp RPAR         &kp LBRC         &kp RBRC
/* Row 1 */  &kp N1           &kp N2           &kp N3           &kp N4           &kp N5           &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp UNDER        &kp PLUS
/* Row 2 */  &kp GRAVE        &kp TILDE        &kp PIPE         &kp BSLH         &kp LT           &kp GT           &kp COLON        &kp SEMI         &kp COMMA        &kp DOT          &kp QUESTION     &kp EQUAL
/* Row 3 */                   &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;
        };

        tech_layer {
            display-name = "TECH";
            bindings = <
/* Row 0 */  &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &out OUT_USB     &out OUT_BLE     &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP     &bootloader
/* Row 1 */  &kp ESC          &kp TAB          &kp HOME         &kp END          &kp PG_UP        &kp PG_DN        &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp INS          &kp DEL
/* Row 2 */  &kp LCTRL        &kp LALT         &kp LGUI         &kp LSHFT        &kp CAPS         &none            &kp RSHFT        &kp RGUI         &kp RALT         &kp RCTRL        &none            &sys_reset
/* Row 3 */                   &to 0            &to 0            &kp ENTER        &kp SPACE        &to 0            &to 0            &kp SPACE        &kp ENTER        &to 0            &to 0
            >;
        };
    };
};
